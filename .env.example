GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local pilot only by default. Never put these values in browser code.
SCENTSELF_STUDY_MODE=pilot
SCENTSELF_LLM_PROVIDER=gemini
SCENTSELF_GEMINI_MODEL=gemini-3.5-flash-lite
SCENTSELF_ADMIN_TOKEN=
SCENTSELF_RESEARCH_CONTACT=
# Hosted pilot: confirm a YYYY-MM-DD deadline before launch; no identity is required.
SCENTSELF_RETENTION_UNTIL=
SCENTSELF_LLM_DAILY_LIMIT=50
# SCENTSELF_CONSENT_VERSION=pilot-consent-20261103
# SCENTSELF_DATA_DIR=/var/data/scentself-pilot
# External durable storage for free hosting. Never commit the real connection URL.
# SCENTSELF_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Live collection additionally requires confirmation, a contact and reviewed consent.
# SCENTSELF_LIVE_CONFIRMED=yes
# SCENTSELF_CONSENT_VERSION=reviewed-consent-v1
